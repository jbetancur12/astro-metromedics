# API Configuration for Production
PUBLIC_API_URL=https://api.metromedicslab.com.co

# Development API (copy to .env for local development)
# PUBLIC_API_URL=http://localhost:5050

# Lead Magnet Modal (set to false to disable in production)
PUBLIC_LEAD_MAGNET_ENABLED=true

