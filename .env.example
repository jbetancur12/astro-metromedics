# API Configuration for Production
PUBLIC_API_URL=https://api.metromedicslab.com

# Development API (copy to .env for local development)
# PUBLIC_API_URL=http://localhost:5050

# Lead Magnet Modal (set to false to disable in production)
PUBLIC_LEAD_MAGNET_ENABLED=true

# Tracking Pixels (leave empty to disable)
PUBLIC_FACEBOOK_PIXEL_ID=
# Google Analytics 4 se configura dentro de GTM (GTM-MB52DKRX), no aquí

# PostHog (leave key empty to disable)
PUBLIC_POSTHOG_KEY=
PUBLIC_POSTHOG_HOST=https://us.i.posthog.com