---
import Layout from "../../layouts/Layout.astro";
import MaintenanceReportForm from "../../components/maintenance/MaintenanceReportForm.tsx";
---

<Layout
  title="Solicitar Mantenimiento de Equipos | Metromedics SAS"
  description="Diligencie el formulario de solicitud de mantenimiento para equipos médicos e industriales. Adjunte archivos, describa el problema y reciba atención de técnicos certificados en Colombia."
>
  <main class="min-h-screen bg-gradient-to-b from-blue-50 to-white py-8">
    <div class="container mx-auto px-4">
      <MaintenanceReportForm client:load />
    </div>
  </main>
</Layout>