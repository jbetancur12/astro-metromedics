---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Página no encontrada - Error 404 | Metromedics SAS"
  description="La página que buscas no está disponible. Regresa al inicio de Metromedics SAS, expertos en calibración de equipos médicos e industriales en Dosquebradas, Colombia."
>
  <div class="h-screen w-screen bg-gray-50 flex items-center">
    <div class="container flex flex-col md:flex-row items-center justify-between px-5 text-gray-700">
      <div class="w-full lg:w-1/2 mx-8">
        <div class="text-7xl text-green-300 font-dark font-extrabold mb-8">
          404
        </div>
        <p class="text-2xl md:text-3xl font-light leading-normal mb-8">
          Lo siento, no pudimos encontrar la página que estás buscando.
        </p>

        <a
          href="/"
          class="px-5 inline py-3 text-sm font-medium leading-5 shadow-2xl text-white transition-all duration-400 border border-transparent rounded-lg focus:outline-none bg-green-600 active:bg-red-600 hover:bg-red-700"
          >Volver a la página de inicio.</a
        >
      </div>
      <div class="w-full lg:flex lg:justify-end lg:w-1/2 mx-5 my-12">
        <img
          src="/images/Logo-pagina-web.png"
          class="max-w-xs opacity-50"
          alt="Metromedics SAS - Calibración y Mantenimiento de Equipos Médicos e Industriales"
        />
      </div>
    </div>
  </div>
</Layout>
