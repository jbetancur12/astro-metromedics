---
import Layout from "../layouts/Layout.astro";

import Hero from "../components/landing/Hero.astro";
import Magnitudes from "../components/landing/Magnitudes.astro";
import Phrase from "../components/landing/Phrase.astro";
import Services from "../components/landing/Services.astro";
import Testimonials from "../components/landing/Testimonials.astro";
import VideoShowcase from "../components/landing/VideoShowcase.astro";
---

<Layout
  title="Metromedics SAS | Calibración Médica e Industrial en Colombia"
  description="Expertos en calibración de equipos médicos e industriales. Laboratorio acreditado ONAC en Dosquebradas y Bogotá. Solicite su cotización sin compromiso."
>
  <Hero />
  <Magnitudes />
  <VideoShowcase />
  <Services />
  <Testimonials />
  <Phrase />

  <!-- Cotización -->
  <section id="cotizar" class="bg-ink text-white">
    <div class="mx-auto flex max-w-[1240px] flex-wrap items-center justify-between gap-8 px-6 py-20">
      <div class="max-w-[620px]">
        <h2 class="text-[clamp(28px,3vw,38px)] font-light leading-[1.15] tracking-[-0.015em]">¿Necesita calibrar o mantener sus equipos?</h2>
        <p class="mt-3.5 text-base leading-relaxed text-white/75">
          Cuéntenos qué equipos tiene y le enviamos una cotización sin compromiso. Respondemos en menos de 24 horas hábiles.
        </p>
      </div>
      <div class="flex flex-wrap gap-4">
        <a href="/contacto" class="rounded-sm bg-primary-500 px-7 py-4 text-xs font-semibold tracking-[0.18em] text-ink no-underline transition-colors hover:bg-primary-300 hover:text-ink">SOLICITAR COTIZACIÓN</a>
        <a href="/blog" class="rounded-sm border border-white/45 px-7 py-[15px] text-xs font-medium tracking-[0.18em] text-white no-underline transition-colors hover:border-white hover:text-white">BLOG DE METROLOGÍA</a>
      </div>
    </div>
  </section>
</Layout>
