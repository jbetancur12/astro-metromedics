---
import Layout from "../layouts/Layout.astro";

import Accreditation from "../components/landing/Accreditation.astro";
import Carrousel from "../components/landing/Carrousel.astro";
import Phrase from "../components/landing/Phrase.astro";
import Services from "../components/landing/Services.astro";
import Testimonials from "../components/landing/Testimonials.astro";
import VideoShowcase from "../components/landing/VideoShowcase.astro";
---

<!-- description="Metromedics S.A.S Dosquebradas: Expertos en Calibración y Mantenimiento de Equipos Médicos e Industriales. Contribuimos a la Estandarización de la Medición en el Sector de la Salud y la Industria." -->
<Layout
  title="Metromedics SAS | Calibración Médica e Industrial en Colombia"
  description="Expertos en calibración de equipos médicos e industriales. Laboratorio acreditado ONAC en Dosquebradas y Bogotá. Solicite su cotización sin compromiso."
>
  <Carrousel />
  <!-- <Hero /> -->
  <!-- <Slider client:visible/> -->
  <VideoShowcase />
  <Accreditation />
  <Services />
  <Testimonials />
  <Phrase />

  <!-- Blog Link Section -->
  <section class="py-16 bg-white">
    <div class="container mx-auto px-4 text-center">
      <a
        href="/blog"
        class="inline-flex items-center px-8 py-4 bg-gradient-to-r from-medical-blue to-primary-600 text-white font-semibold rounded-xl hover:shadow-lg transition-all duration-200 transform hover:scale-105"
      >
        <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20l-5.5-5.5M15 10a5 5 0 11-10 0 5 5 0 0110 0z"></path>
        </svg>
        Visite Nuestro Blog de Metrología
      </a>
    </div>
  </section>
  <!-- <More />
  <Features />
  <About />
  <Projects/> -->
</Layout>
<!-- En Metromedics S.A.S Dosquebradas, somos expertos en la calibración y mantenimiento de equipos médicos e industriales. Nuestro compromiso es garantizar la precisión y confiabilidad de los resultados. Contamos con un equipo altamente capacitado, tecnología de vanguardia y seguimos normativas internacionales. Trabajamos con una amplia gama de equipos en el sector de la salud y la industria. Ofrecemos servicios de calibración, corrección de desviaciones, ajustes, reemplazo de piezas y emitimos certificados. Además, brindamos asesoramiento, capacitación y programas de mantenimiento preventivo. Confía en nosotros para mantener tus equipos en óptimas condiciones -->
