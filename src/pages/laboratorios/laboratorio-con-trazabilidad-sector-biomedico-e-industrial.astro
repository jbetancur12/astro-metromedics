---
import { Picture } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import volumenImg from '../../assets/images/V.jpg';
import flujoImg from '../../assets/images/F.jpg';
import trazaImg from '../../assets/images/Traza.jpg';

const cadena = [
  { n: '01', titulo: 'Sistema Internacional (SI)', texto: 'La definición de la unidad.' },
  { n: '02', titulo: 'NIST y referencias nacionales', texto: 'Institutos que materializan la unidad.' },
  { n: '03', titulo: 'Patrones de Metromedics', texto: 'Calibrados contra esas referencias.' },
  { n: '04', titulo: 'Su equipo', texto: 'Calibrado contra nuestros patrones.', destacado: true },
];

const laboratorios = [
  {
    n: '01 · LABORATORIO DE VOLUMEN',
    rango: '1 µL a 200 mL',
    img: volumenImg,
    alt: 'Calibración de instrumentos de volumen: micropipeta, bureta y balones aforados',
    items: [
      'Micropipetas fijas y variables',
      'Micropipetas multicanal',
      'Buretas',
      'Picnómetros',
      'Balones aforados',
      'Probetas graduadas',
    ],
  },
  {
    n: '02 · LABORATORIO DE FLUJO',
    rango: '0 a 1 000 L/min',
    img: flujoImg,
    alt: 'Calibración de equipos de flujo: bomba de infusión, ventilador y regulador de oxígeno',
    items: [
      'Bombas de infusión',
      'Flujómetros',
      'Reguladores de oxígeno',
      'Ventiladores mecánicos',
      'Máquinas de anestesia',
      'Cabinas de flujo laminar',
      'Nebulizadores',
      'Y otros equipos: consúltenos',
    ],
  },
];
---

<Layout
  title="Laboratorio con Trazabilidad SI: Biomédico e Industrial | Metromedics SAS"
  description="Laboratorio de calibración con trazabilidad al SI y NIST. Servicios para los sectores biomédico e industrial en Dosquebradas y Bogotá. Solicite su cotización."
>
  <!-- Hero -->
  <section class="bg-ink text-white">
    <div class="container mx-auto px-4 max-w-[1240px] pt-10 pb-20 lg:pb-24">
      <nav aria-label="Ruta" class="text-sm text-white/65 flex flex-wrap gap-2">
        <a href="/" class="text-white/75 hover:text-white">Inicio</a><span aria-hidden="true">/</span><span>Laboratorios</span><span aria-hidden="true">/</span><span aria-current="page" class="text-white">Laboratorio con trazabilidad</span>
      </nav>
      <div class="mt-12 grid lg:grid-cols-2 gap-12 items-center">
        <div>
          <span class="text-xs font-medium tracking-[0.3em] text-primary-100">SECTOR BIOMÉDICO E INDUSTRIAL</span>
          <h1 class="mt-5 text-4xl lg:text-[54px] font-light leading-[1.08] tracking-tight">Laboratorio con trazabilidad al Sistema Internacional</h1>
          <p class="mt-6 max-w-xl text-lg leading-relaxed text-white/75">
            Calibramos volumen y flujo con patrones de referencia trazables al SI a través de NIST, con equipos de última tecnología y personal calificado.
          </p>
          <div class="mt-9 flex flex-col sm:flex-row gap-4">
            <a href="/contacto" class="px-7 py-4 bg-primary-500 hover:bg-primary-400 text-primary-900 text-xs font-semibold tracking-[0.18em] rounded-sm text-center transition-colors">SOLICITAR CALIBRACIÓN</a>
            <a href="#laboratorios" class="px-7 py-4 border border-white/45 hover:border-white text-white text-xs font-medium tracking-[0.18em] rounded-sm text-center transition-colors">VER LABORATORIOS</a>
          </div>
        </div>
        <Picture
          src={trazaImg}
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          widths={[480, 800, 1200]}
          sizes="(min-width: 1024px) 600px, 100vw"
          alt="Patrones de referencia en vitrina y técnico revisando un certificado de calibración"
          loading="eager"
          class="w-full h-64 lg:h-[380px] object-cover rounded"
        />
      </div>
    </div>
  </section>

  <!-- Qué es la trazabilidad -->
  <section class="bg-paper">
    <div class="container mx-auto px-4 max-w-[1240px] py-20 lg:py-24">
      <span class="text-xs font-semibold tracking-[0.3em] text-primary-700">QUÉ ES LA TRAZABILIDAD</span>
      <h2 class="mt-4 max-w-3xl text-3xl lg:text-4xl font-light leading-tight tracking-tight text-ink">
        Una cadena ininterrumpida de calibraciones que une la medida de su equipo con la definición de la unidad.
      </h2>
      <ol aria-label="Cadena de trazabilidad" class="mt-12 flex flex-col lg:flex-row lg:items-stretch gap-3">
        {cadena.map((paso, i) => (
          <>
            <li class={`flex-1 rounded p-6 flex flex-col gap-1.5 ${paso.destacado ? 'bg-ink' : 'bg-white border border-gray-200'}`}>
              <span class={`text-xs tracking-[0.2em] ${paso.destacado ? 'text-primary-100' : 'text-primary-700'}`}>{paso.n}</span>
              <span class={`text-lg font-medium ${paso.destacado ? 'text-white' : 'text-ink'}`}>{paso.titulo}</span>
              <span class={`text-sm leading-relaxed ${paso.destacado ? 'text-white/75' : 'text-gray-600'}`}>{paso.texto}</span>
            </li>
            {i < cadena.length - 1 && (
              <li aria-hidden="true" class="flex items-center justify-center text-primary-700 text-2xl rotate-90 lg:rotate-0">→</li>
            )}
          </>
        ))}
      </ol>
    </div>
  </section>

  <!-- Laboratorios -->
  <section id="laboratorios" class="bg-white">
    <div class="container mx-auto px-4 max-w-[1240px] py-20 lg:py-28">
      <span class="text-xs font-semibold tracking-[0.3em] text-primary-700">NUESTROS LABORATORIOS</span>
      <h2 class="mt-4 text-3xl lg:text-4xl font-light tracking-tight text-ink">Volumen y flujo</h2>

      <div class="mt-14 space-y-20">
        {laboratorios.map((lab, i) => (
          <div class="grid lg:grid-cols-2 gap-12 items-center">
            <div class={i % 2 === 1 ? 'lg:order-2' : ''}>
              <Picture
                src={lab.img}
                formats={["avif", "webp"]}
                fallbackFormat="webp"
                widths={[480, 800, 1200]}
                sizes="(min-width: 1024px) 600px, 100vw"
                alt={lab.alt}
                class="w-full h-72 lg:h-[400px] object-cover rounded"
              />
            </div>
            <div class={i % 2 === 1 ? 'lg:order-1' : ''}>
              <span class="text-xs tracking-[0.2em] text-primary-700">{lab.n}</span>
              <div class="mt-3 text-3xl lg:text-4xl font-light tracking-tight text-ink">{lab.rango}</div>
              <ul class="mt-7 grid sm:grid-cols-2 gap-x-6 border-t border-gray-200">
                {lab.items.map((item) => (
                  <li class="py-3.5 border-b border-gray-200 text-[15px] text-gray-800">{item}</li>
                ))}
              </ul>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Auditoría -->
  <section class="bg-paper border-t border-gray-200">
    <div class="container mx-auto px-4 max-w-[1240px] py-16 flex flex-col lg:flex-row lg:items-center justify-between gap-6">
      <div class="max-w-2xl">
        <h2 class="text-2xl font-normal text-ink">¿Su auditoría pide calibración acreditada?</h2>
        <p class="mt-2.5 text-[15px] leading-relaxed text-gray-600">Masa, presión y temperatura las calibramos bajo acreditación ONAC 18-LAC-020.</p>
      </div>
      <a href="/laboratorios/laboratorio-acreditado/" class="px-7 py-4 border border-ink text-ink hover:bg-ink hover:text-white text-xs font-semibold tracking-[0.18em] rounded-sm text-center transition-colors">VER LABORATORIO ACREDITADO</a>
    </div>
  </section>

  <!-- Cotizar -->
  <section id="cotizar" class="bg-ink text-white">
    <div class="container mx-auto px-4 max-w-[1240px] py-20 flex flex-col lg:flex-row lg:items-center justify-between gap-8">
      <div class="max-w-xl">
        <h2 class="text-3xl lg:text-4xl font-light leading-tight tracking-tight">Cotice la calibración de sus equipos biomédicos</h2>
        <p class="mt-3.5 text-base leading-relaxed text-white/75">Consulta técnica por WhatsApp, lunes a viernes de 8:00 a. m. a 6:00 p. m.</p>
      </div>
      <div class="flex flex-col sm:flex-row gap-4">
        <a href="/contacto" class="px-7 py-4 bg-primary-500 hover:bg-primary-400 text-primary-900 text-xs font-semibold tracking-[0.18em] rounded-sm text-center transition-colors">SOLICITAR COTIZACIÓN</a>
        <a href="https://wa.me/573012541543" class="px-7 py-4 border border-white/45 hover:border-white text-white text-xs font-medium tracking-[0.18em] rounded-sm text-center transition-colors">WHATSAPP</a>
        <a href="tel:+576063526161" class="px-7 py-4 border border-white/45 hover:border-white text-white text-xs font-medium tracking-[0.18em] rounded-sm text-center transition-colors">LLAMAR</a>
      </div>
    </div>
  </section>
</Layout>
