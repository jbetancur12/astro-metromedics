---
import Layout from "../../layouts/Layout.astro";
---

<Layout
  title="Metromedics SAS | Calibración y Mantenimiento de Equipos Médicos e Industriales"
  description="Metromedics S.A.S Dosquebradas: Expertos en Calibración y Mantenimiento de Equipos Médicos e Industriales. Contribuimos a la Estandarización de la Medición en el Sector de la Salud y la Industria."
>
  <!-- Modern Hero Section -->
  <section
    class="bg-gradient-to-br from-medical-blue to-primary-600 text-white py-20"
  >
    <div class="container mx-auto px-4">
      <div class="max-w-4xl mx-auto text-center">
        <div
          class="w-16 h-16 bg-white/10 rounded-2xl flex items-center justify-center mx-auto mb-6"
        >
          <svg
            class="w-8 h-8 text-white"
            fill="currentColor"
            viewBox="0 0 20 20"
          >
            <path
              fill-rule="evenodd"
              d="M6.267 3.455a3.066 3.066 0 001.745-.723 3.066 3.066 0 013.976 0 3.066 3.066 0 001.745.723 3.066 3.066 0 012.812 2.812c.051.643.304 1.254.723 1.745a3.066 3.066 0 010 3.976 3.066 3.066 0 00-.723 1.745 3.066 3.066 0 01-2.812 2.812 3.066 3.066 0 00-1.745.723 3.066 3.066 0 01-3.976 0 3.066 3.066 0 00-1.745-.723 3.066 3.066 0 01-2.812-2.812 3.066 3.066 0 00-.723-1.745 3.066 3.066 0 010-3.976 3.066 3.066 0 00.723-1.745 3.066 3.066 0 012.812-2.812zm7.44 5.252a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
              clip-rule="evenodd"></path>
          </svg>
        </div>
        <h1 class="text-display-lg font-bold mb-6">
          Laboratorio Acreditado ONAC
        </h1>
        <p class="text-xl mb-8 text-blue-100 leading-relaxed">
          Certificado bajo la norma ISO/IEC 17025:2017 con código de
          acreditación 18-LAC-020. Garantizamos la máxima precisión y
          trazabilidad en nuestros servicios de calibración.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="/contacto"
            class="inline-flex items-center px-6 py-3 bg-white text-medical-blue font-semibold rounded-xl hover:bg-gray-100 transition-colors"
          >
            <svg
              class="w-5 h-5 mr-2"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M3 8l7.89 4.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
              ></path>
            </svg>
            Solicitar Calibración
          </a>
          <a
            href="#magnitudes"
            class="inline-flex items-center px-6 py-3 bg-white/10 backdrop-blur-sm text-white font-semibold rounded-xl border-2 border-white/30 hover:bg-white/20 transition-colors"
          >
            <svg
              class="w-5 h-5 mr-2"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
            </svg>
            Ver Magnitudes
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ONAC Certification Section -->
  <section class="py-16 bg-gradient-to-b from-gray-50 to-white">
    <div class="container mx-auto px-4">
      <div class="max-w-4xl mx-auto text-center">
        <div class="bg-white rounded-2xl shadow-large p-8 mb-12">
          <img
            src="/images/onac_grande.png"
            alt="Certificación ONAC MetroMedics"
            class="mx-auto mb-6 max-h-32"
          />
          <h2 class="text-2xl font-bold text-gray-900 mb-4">
            Acreditación ONAC Vigente
          </h2>
          <p class="text-lg text-gray-600 leading-relaxed">
            En MetroMedics SAS contamos con acreditación ONAC vigente a la
            fecha, con
            <strong class="text-medical-blue"
              >código de acreditación 18-LAC-020</strong
            >, bajo la norma ISO/IEC 17025: 2017. Esta certificación garantiza
            la competencia técnica y confiabilidad de nuestros servicios de
            calibración.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Magnitudes Section -->
  <section id="magnitudes" class="py-20 bg-white">
    <div class="container mx-auto px-4">
      <div class="text-center mb-16">
        <h2 class="text-display-md font-bold text-gray-900 mb-4">
          Magnitudes <span class="text-medical-blue">Acreditadas</span>
        </h2>
        <p class="text-xl text-gray-600 max-w-3xl mx-auto">
          Ofrecemos servicios de calibración acreditados en las siguientes
          magnitudes, con los más altos estándares de precisión y trazabilidad.
        </p>
      </div>

      <div class="grid lg:grid-cols-2 xl:grid-cols-3 gap-8 max-w-7xl mx-auto">

  <!-- Magnitud Masa -->
  <div class="bg-white rounded-2xl border border-gray-100 overflow-hidden group hover:shadow-lg transition-all duration-300">
    <div class="relative aspect-square bg-[#0f1e2e] overflow-hidden">
      <img
        src="/images/item2-291x300.jpg"
        alt="Calibración de Magnitud Masa"
        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-black/50 to-transparent"></div>
 
      <div class="absolute bottom-3.5 left-4 right-4">
        <h3 class="text-xl font-medium text-white leading-tight">Magnitud Masa</h3>
      </div>
    </div>
    <div class="p-5 space-y-3">
      <p class="text-[11px] font-medium tracking-widest uppercase text-gray-400">Instrumentos cubiertos</p>

      <div class="flex items-start gap-2.5">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 flex-shrink-0 mt-1.5"></span>
        <div class="flex flex-col gap-2 flex-1">
          <p class="text-sm text-gray-500">Instrumentos de pesaje no automático</p>
          <p class="text-xs text-gray-400">Rango — <em>m</em></p>
          <div class="grid grid-cols-2 gap-1.5">
            <div class="col-span-2 bg-gray-50 border border-gray-100 rounded-lg px-2.5 py-1.5 text-xs font-medium text-gray-700">
              1 mg ≤ <em>m</em> ≤ 1 000 kg
            </div>
          </div>
        </div>
      </div>

      <div class="flex items-start gap-2.5">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 flex-shrink-0 mt-1.5"></span>
        <div class="flex flex-col gap-2 flex-1">
          <p class="text-sm text-gray-500">Pesas clase OIML M1, M2, M3</p>
          <p class="text-xs text-gray-400">Rango</p>
          <div class="grid grid-cols-2 gap-1.5">
            <div class="col-span-2 bg-gray-50 border border-gray-100 rounded-lg px-2.5 py-1.5 text-xs font-medium text-gray-700">
              1 g – 20 kg
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Magnitud Presión -->
  <div class="bg-white rounded-2xl border border-gray-100 overflow-hidden group hover:shadow-lg transition-all duration-300">
    <div class="relative aspect-square bg-[#0f1e2e] overflow-hidden">
      <img
        src="/images/item1-292x300.jpg"
        alt="Calibración de Magnitud Presión"
        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-black/50 to-transparent"></div>
 
      <div class="absolute bottom-3.5 left-4 right-4">
        <h3 class="text-xl font-medium text-white leading-tight">Magnitud Presión</h3>
      </div>
    </div>
    <div class="p-5 space-y-3">
      <p class="text-[11px] font-medium tracking-widest uppercase text-gray-400">Instrumentos cubiertos</p>

      <div class="flex items-start gap-2.5">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 flex-shrink-0 mt-1.5"></span>
        <div class="flex flex-col gap-2 flex-1">
          <p class="text-sm text-gray-500">Tensiómetros</p>
          <p class="text-xs text-gray-400">Rangos</p>
          <div class="grid grid-cols-2 gap-1.5">
            <div class="bg-gray-50 border border-gray-100 rounded-lg px-2.5 py-1.5 text-xs font-medium text-gray-700">
              50 – 300 mmHg
            </div>
            <div class="bg-gray-50 border border-gray-100 rounded-lg px-2.5 py-1.5 text-xs font-medium text-gray-700">
              6.67 – 40 KPa
            </div>
          </div>
        </div>
      </div>

      <div class="flex items-start gap-2.5">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 flex-shrink-0 mt-1.5"></span>
        <div class="flex flex-col gap-2 flex-1">
          <p class="text-sm text-gray-500">Vacuómetros, manómetros, manovacuómetros</p>
          <p class="text-xs text-gray-400">Rangos — <em>p</em> en psi</p>
          <div class="grid grid-cols-2 gap-1.5">
            <div class="bg-gray-50 border border-gray-100 rounded-lg px-2.5 py-1.5 text-xs font-medium text-gray-700">
              −10 ≤ <em>p</em> &lt; 0
            </div>
            <div class="bg-gray-50 border border-gray-100 rounded-lg px-2.5 py-1.5 text-xs font-medium text-gray-700">
              0 ≤ <em>p</em> &lt; 15
            </div>
            <div class="bg-gray-50 border border-gray-100 rounded-lg px-2.5 py-1.5 text-xs font-medium text-gray-700">
              15 ≤ <em>p</em> &lt; 1 500
            </div>
            <div class="bg-gray-50 border border-gray-100 rounded-lg px-2.5 py-1.5 text-xs font-medium text-gray-700">
              1 500 ≤ <em>p</em> &lt; 10 000
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Temperatura y Humedad Relativa -->
  <div class="bg-white rounded-2xl border border-gray-100 overflow-hidden group hover:shadow-lg transition-all duration-300">
    <div class="relative aspect-square bg-[#0f1e2e] overflow-hidden">
      <img
        src="/images/items_temp_relativa-292x300.jpg"
        alt="Calibración de Temperatura y Humedad Relativa"
        class="w-full h-full object-cover  group-hover:scale-105 transition-transform duration-500"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-black/50 to-transparent"></div>
 
      <div class="absolute bottom-3.5 left-4 right-4">
        <h3 class="text-xl font-medium text-white leading-tight">Temperatura y Humedad</h3>
      </div>
    </div>
    <div class="p-5 space-y-3">
      <p class="text-[11px] font-medium tracking-widest uppercase text-gray-400">Instrumentos cubiertos</p>

      <div class="flex items-start gap-2.5">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 flex-shrink-0 mt-1.5"></span>
        <div class="flex flex-col gap-2 flex-1">
          <p class="text-sm text-gray-500">Termohigrómetros, higrómetros, termómetros digitales, sensores, dataloggers</p>
          <p class="text-xs text-gray-400">Rangos</p>
          <div class="grid grid-cols-2 gap-1.5">
            <div class="bg-gray-50 border border-gray-100 rounded-lg px-2.5 py-1.5 text-xs font-medium text-gray-700">
              10 – 40 °C
            </div>
            <div class="bg-gray-50 border border-gray-100 rounded-lg px-2.5 py-1.5 text-xs font-medium text-gray-700">
              15 – 90 %HR
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Temperatura de Contacto -->
  <div class="bg-white rounded-2xl border border-gray-100 overflow-hidden group hover:shadow-lg transition-all duration-300">
    <div class="relative aspect-square bg-[#0f1e2e] overflow-hidden">
      <img
        src="/images/items_temp-292x300.jpg"
        alt="Calibración de Temperatura de Contacto"
        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-black/50 to-transparent"></div>
 
      <div class="absolute bottom-3.5 left-4 right-4">
        <h3 class="text-xl font-medium text-white leading-tight">Temperatura de Contacto</h3>
      </div>
    </div>
    <div class="p-5 space-y-3">
      <p class="text-[11px] font-medium tracking-widest uppercase text-gray-400">Instrumentos cubiertos</p>

      <div class="flex items-start gap-2.5">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 flex-shrink-0 mt-1.5"></span>
        <div class="flex flex-col gap-2 flex-1">
          <p class="text-sm text-gray-500">Termómetros de cadena de frío, punzón, sensores, termoresistores, dataloggers, controladores</p>
          <p class="text-xs text-gray-400">Alcance acreditado — <em>t</em></p>
          <div class="grid grid-cols-2 gap-1.5">
            <div class="bg-gray-50 border border-gray-100 rounded-lg px-2.5 py-1.5 text-xs font-medium text-gray-700">
              −30 ≤ <em>t</em> &lt; 150 °C
            </div>
            <div class="bg-gray-50 border border-gray-100 rounded-lg px-2.5 py-1.5 text-xs font-medium text-gray-700">
              150 ≤ <em>t</em> &lt; 350 °C
            </div>
            <div class="col-span-2 bg-gray-50 border border-gray-100 rounded-lg px-2.5 py-1.5 text-xs font-medium text-gray-700">
              350 ≤ <em>t</em> &lt; 600 °C
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Caracterización de Equipos -->
  <div class="bg-white rounded-2xl border border-gray-100 overflow-hidden group hover:shadow-lg transition-all duration-300 lg:col-span-2 xl:col-span-1">
    <div class="relative aspect-square bg-[#0f1e2e] overflow-hidden">
      <img
        src="/images/isotermicos3.png"
        alt="Caracterización de Equipos Isotérmicos"
        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-black/50 to-transparent"></div>

      <div class="absolute bottom-3.5 left-4 right-4">
        <h3 class="text-xl font-medium text-white leading-tight">Caracterización de Equipos</h3>
      </div>
    </div>
    <div class="p-5 space-y-3">
      <p class="text-[11px] font-medium tracking-widest uppercase text-gray-400">Instrumentos cubiertos</p>

      <div class="flex items-start gap-2.5">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 flex-shrink-0 mt-1.5"></span>
        <div class="flex flex-col gap-2 flex-1">
          <p class="text-sm text-gray-500">Cámaras ambientales, hornos, incubadoras, refrigeradores, congeladores, bloques secos</p>
          <p class="text-xs text-gray-400">Rangos</p>
          <div class="grid grid-cols-2 gap-1.5">
            <div class="bg-gray-50 border border-gray-100 rounded-lg px-2.5 py-1.5 text-xs font-medium text-gray-700">
              −30 – 350 °C
            </div>
            <div class="bg-gray-50 border border-gray-100 rounded-lg px-2.5 py-1.5 text-xs font-medium text-gray-700">
              30 – 85 %HR
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

</div>
    </div>
  </section>

  <!-- CTA Section -->
  <section
    class="py-20 bg-gradient-to-r from-medical-blue to-primary-600 text-white"
  >
    <div class="container mx-auto px-4">
      <div class="max-w-4xl mx-auto text-center">
        <h2 class="text-3xl font-bold mb-4">
          ¿Necesitas calibración acreditada para tus equipos?
        </h2>
        <p class="text-xl text-blue-100 mb-8">
          Confía en nuestro laboratorio acreditado ONAC para garantizar la
          precisión y trazabilidad de tus instrumentos de medición.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="/contacto"
            class="inline-flex items-center px-8 py-4 bg-white text-medical-blue font-semibold rounded-xl hover:bg-gray-100 transition-colors shadow-lg"
          >
            <svg
              class="w-5 h-5 mr-2"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"
              ></path>
            </svg>
            Solicitar Cotización
          </a>
          <a
            href="tel:+5760635261611"
            class="inline-flex items-center px-8 py-4 bg-white/10 backdrop-blur-sm text-white font-semibold rounded-xl border-2 border-white/30 hover:bg-white/20 transition-colors"
          >
            <svg
              class="w-5 h-5 mr-2"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
              ></path>
            </svg>
            Llamar Ahora
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>
