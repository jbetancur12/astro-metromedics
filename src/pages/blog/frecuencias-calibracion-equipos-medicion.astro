                  <td class="py-3 px-4">6 meses</td>
                  <td class="py-3 pl-4">NTC-ISO 81060-2</td>
                </tr>
                <tr class="border-b border-gray-200">
                  <td class="py-3 pr-4 font-medium">Balanzas electrónicas</td>
                  <td class="py-3 px-4">12 meses</td>
                  <td class="py-3 px-4">6 meses</td>
                  <td class="py-3 pl-4">NTC 2031 (OIML R76)</td>
                </tr>
                <tr class="border-b border-gray-200">
                  <td class="py-3 pr-4 font-medium">Básculas mecánicas</td>
                  <td class="py-3 px-4">12 meses</td>
                  <td class="py-3 px-4">6 meses</td>
                  <td class="py-3 pl-4">NTC 2031 (OIML R76)</td>
                </tr>
                <tr class="border-b border-gray-200">
                  <td class="py-3 pr-4 font-medium">Termómetros digitales</td>
                  <td class="py-3 px-4">12 meses</td>
                  <td class="py-3 px-4">6 meses</td>
                  <td class="py-3 pl-4">NTC-ISO 17025</td>
                </tr>
                <tr class="border-b border-gray-200">
                  <td class="py-3 pr-4 font-medium">Termómetros de mercurio</td>
                  <td class="py-3 px-4">24 meses</td>
                  <td class="py-3 px-4">12 meses</td>
                  <td class="py-3 pl-4">NTC-ISO 17025</td>
                </tr>
                <tr class="border-b border-gray-200">
                  <td class="py-3 pr-4 font-medium">Manómetros industriales</td>
                  <td class="py-3 px-4">12 meses</td>
                  <td class="py-3 px-4">6 meses</td>
                  <td class="py-3 pl-4">NTC-ISO 17025</td>
                </tr>
                <tr class="border-b border-gray-200">
                  <td class="py-3 pr-4 font-medium">Higrómetros y termohigrómetros</td>
