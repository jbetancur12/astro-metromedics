                  <td class="py-3 px-4">6 meses</td>
                  <td class="py-3 pl-4">NTC-ISO 17025</td>
                </tr>
                <tr class="border-b border-gray-200">
                  <td class="py-3 pr-4 font-medium">Espectrofotómetros</td>
                  <td class="py-3 px-4">12 meses</td>
