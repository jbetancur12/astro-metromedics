---
import { Picture } from "astro:assets";
import services from "../config/services.json";
import masaImg from "../assets/images/M.jpg";
import presionImg from "../assets/images/P.jpg";
import humedadImg from "../assets/images/TH.jpg";
import calibracionImg from "../assets/images/home/servicio-calibracion.webp";
import autoclavesImg from "../assets/images/home/servicio-autoclaves.webp";
import mantenimientoImg from "../assets/images/home/servicio-mantenimiento.webp";
import ventaImg from "../assets/images/servici2.webp";
import Layout from "../layouts/Layout.astro";

// Etiqueta y enlaces extra por servicio (el texto, la imagen y el portafolio
// siguen viniendo de config/services.json).
// Fotos de cada servicio, optimizadas por Astro (mismo orden que services.json).
const fotos = [calibracionImg, masaImg, presionImg, humedadImg, autoclavesImg, mantenimientoImg, ventaImg];

const extras = [
  {
    etiqueta: "ACREDITADO ONAC",
    enlaces: [
      { texto: "LABORATORIO ACREDITADO →", href: "/laboratorios/laboratorio-acreditado/" },
      { texto: "VOLUMEN Y FLUJO →", href: "/laboratorios/laboratorio-con-trazabilidad-sector-biomedico-e-industrial/" },
    ],
  },
  { etiqueta: "MASA · ACREDITADO", enlaces: [] },
  { etiqueta: "PRESIÓN · ACREDITADO", enlaces: [] },
  { etiqueta: "TEMPERATURA · ACREDITADO", enlaces: [] },
  { etiqueta: "VALIDACIÓN", enlaces: [] },
  {
    etiqueta: "MANTENIMIENTO",
    enlaces: [{ texto: "SOLICITAR MANTENIMIENTO →", href: "/mantenimiento/solicitar" }],
  },
  { etiqueta: "VENTA", enlaces: [] },
];
---

<Layout
  title="Servicios: Calibración Médica e Industrial | Metromedics SAS"
  description="Calibración de equipos médicos e industriales, mantenimiento y validación de autoclaves. Laboratorio acreditado ONAC en Dosquebradas y Bogotá. ¡Solicite su cotización!"
>
  <!-- Hero -->
  <section class="bg-ink text-white">
    <div class="mx-auto max-w-[1240px] px-6 pb-20 pt-10 lg:pb-24">
      <nav aria-label="Ruta" class="flex flex-wrap gap-2 text-sm text-white/65">
        <a href="/" class="text-white/90 hover:text-white">Inicio</a><span aria-hidden="true">/</span><span aria-current="page" class="text-white">Servicios</span>
      </nav>
      <div class="mt-12 max-w-3xl">
        <span class="text-xs font-medium tracking-[0.3em] text-primary-100">SERVICIOS</span>
        <h1 class="mt-5 text-4xl font-light leading-[1.08] tracking-tight lg:text-[54px]">Servicios de calibración para los sectores médico e industrial</h1>
        <p class="mt-6 max-w-2xl text-lg leading-relaxed text-white/90">
          Soluciones integrales de calibración y mantenimiento de equipos médicos e industriales. Nuestro equipo técnico garantiza que sus equipos operen con la máxima precisión y cumplan las normativas vigentes.
        </p>
        <div class="mt-9 flex flex-col gap-4 sm:flex-row">
          <a href="#servicios" class="rounded-sm bg-primary-500 px-7 py-4 text-center text-xs font-semibold tracking-[0.18em] text-ink-900 transition-colors hover:bg-primary-300">VER SERVICIOS</a>
          <a href="/contacto" class="rounded-sm border border-white/45 px-7 py-4 text-center text-xs font-medium tracking-[0.18em] text-white transition-colors hover:border-white">SOLICITAR COTIZACIÓN</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Servicios -->
  <section id="servicios" class="bg-white">
    <div class="mx-auto max-w-[1240px] px-6 py-20 lg:py-28">
      <div class="space-y-20 lg:space-y-28">
        {services.map((service, index) => {
          const extra = extras[index] ?? { etiqueta: "", enlaces: [] };
          const numero = String(index + 1).padStart(2, "0");
          const invertido = index % 2 === 1;
          return (
            <article class="grid items-center gap-10 lg:grid-cols-2 lg:gap-16">
              <div class={invertido ? "lg:order-2" : ""}>
                {fotos[index] ? (
                  <Picture
                    src={fotos[index]}
                    formats={["avif", "webp"]}
                    fallbackFormat="webp"
                    widths={[480, 800, 1200]}
                    sizes="(min-width: 1024px) 600px, 100vw"
                    alt={`Servicio de ${service.title}`}
                    class="h-72 w-full rounded object-cover lg:h-[400px]"
                  />
                ) : (
                  <img
                    src={service.imgUrl}
                    alt={`Servicio de ${service.title}`}
                    width="800"
                    height="600"
                    loading="lazy"
                    class="h-72 w-full rounded object-cover lg:h-[400px]"
                  />
                )}
              </div>
              <div class={invertido ? "lg:order-1" : ""}>
                <span class="text-xs tracking-[0.2em] text-primary-800">{numero}{extra.etiqueta && ` · ${extra.etiqueta}`}</span>
                <h2 class="mt-3 text-3xl font-light leading-tight tracking-tight text-ink lg:text-4xl">{service.title}</h2>
                <p class="mt-5 text-base leading-relaxed text-gray-700">{service.content}</p>
                <div class="mt-7 flex flex-wrap items-center gap-x-6 gap-y-3">
                  {(service.portafolios ?? []).map((p) => (
                    <a href={p.url} target="_blank" rel="noopener" class="rounded-sm border border-ink px-6 py-3.5 text-xs font-semibold uppercase tracking-[0.16em] text-ink no-underline transition-colors hover:bg-ink hover:text-white">{p.etiqueta}</a>
                  ))}
                  {extra.enlaces.map((e) => (
                    <a href={e.href} class="text-xs font-semibold tracking-[0.14em] text-primary-800 no-underline hover:text-ink">{e.texto}</a>
                  ))}
                  <a href="/contacto" class="text-xs font-semibold tracking-[0.14em] text-primary-800 no-underline hover:text-ink">SOLICITAR INFORMACIÓN →</a>
                </div>
              </div>
            </article>
          );
        })}
      </div>
    </div>
  </section>

  <!-- A la medida -->
  <section class="bg-ink text-white">
    <div class="mx-auto flex max-w-[1240px] flex-col justify-between gap-8 px-6 py-20 lg:flex-row lg:items-center">
      <div class="max-w-xl">
        <span class="text-xs font-medium tracking-[0.3em] text-primary-100">SOLUCIÓN A LA MEDIDA</span>
        <h2 class="mt-4 text-3xl font-light leading-tight tracking-tight lg:text-4xl">¿Necesita una solución personalizada?</h2>
        <p class="mt-3.5 text-base leading-relaxed text-white/90">
          Nuestro equipo evalúa sus necesidades y prepara una propuesta a la medida para su empresa.
        </p>
      </div>
      <div class="flex flex-col gap-4 sm:flex-row">
        <a href="/contacto" class="rounded-sm bg-primary-500 px-7 py-4 text-center text-xs font-semibold tracking-[0.18em] text-ink-900 transition-colors hover:bg-primary-300">COTIZACIÓN PERSONALIZADA</a>
        <a href="tel:+576063526161" class="rounded-sm border border-white/45 px-7 py-4 text-center text-xs font-medium tracking-[0.18em] text-white transition-colors hover:border-white">LLAMAR AHORA</a>
      </div>
    </div>
  </section>
</Layout>
