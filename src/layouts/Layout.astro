---
interface Props {
  title: string;
  description: string;
  image?: string;
  type?: "website" | "article";
  publishedTime?: string;
  modifiedTime?: string;
  noindex?: boolean;
}
import Copyright from "../components/landing/Copyright.astro";
import Footer from "../components/landing/Footer.astro";
import Header from "../components/landing/Header.astro";
import WhatsAppFloat from "../components/ui/WhatsAppFloat.astro";
import LeadMagnetModal from "../components/ui/LeadMagnetModal.astro";
import { lastModified } from "../utils/lastModified.mjs";

import "../styles/Layout.css";

const SITE_URL = "https://metromedicslab.com";
const SITE_NAME = "Metromedics SAS";
const LOGO_URL = `${SITE_URL}/images/Logo-pagina-web.png`;
// 1200x630 share image, generated from the brand gradient and the logo
const DEFAULT_IMAGE = `${SITE_URL}/images/og-default.jpg`;

const {
  title,
  description,
  image = DEFAULT_IMAGE,
  type = "website",
  publishedTime,
  modifiedTime = publishedTime,
  noindex = false,
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, SITE_URL).toString();
const imageUrl = new URL(image, SITE_URL).toString();
// Page name without the " | Metromedics SAS" suffix, for breadcrumbs.
const pageName = title.split(" | ")[0];
// Articles use their own dates; other pages, the last commit of their source.
const pageModified = modifiedTime ?? lastModified(Astro.url.pathname);

// JSON-LD Structured Data
const organizationSchema = {
  "@type": "Organization",
  "@id": `${SITE_URL}/#organization`,
  "name": SITE_NAME,
  "alternateName": "Metromedics",
  "url": SITE_URL,
  "logo": LOGO_URL,
  "image": DEFAULT_IMAGE,
  "description": "Calibración y mantenimiento de equipos médicos e industriales. Laboratorio acreditado ONAC bajo ISO/IEC 17025:2017.",
  "areaServed": { "@type": "Country", "name": "Colombia" },
  "knowsAbout": [
    "Calibración de equipos biomédicos",
    "Calibración de equipos industriales",
    "Metrología",
    "ISO/IEC 17025",
    "Mantenimiento de equipos médicos",
    "Validación de autoclaves"
  ],
  "address": [
    {
      "@type": "PostalAddress",
      "streetAddress": "Calle 35 13-46 Guadalupe",
      "addressLocality": "Dosquebradas",
      "addressRegion": "Risaralda",
      "postalCode": "661001",
      "addressCountry": "CO"
    },
    {
      "@type": "PostalAddress",
      "streetAddress": "Cra. 71c #52-34, Oficina 101",
      "addressLocality": "Bogotá",
      "addressRegion": "Bogotá D.C.",
      "addressCountry": "CO"
    }
  ],
  "hasCredential": {
    "@type": "EducationalOccupationalCredential",
    "credentialCategory": "Acreditación de laboratorio",
    "name": "Acreditación ONAC 18-LAC-020 bajo ISO/IEC 17025:2017",
    "url": `${SITE_URL}/pdf/18-LAC-020.pdf`,
    "recognizedBy": { "@type": "Organization", "name": "Organismo Nacional de Acreditación de Colombia (ONAC)", "url": "https://onac.org.co" }
  },
  "contactPoint": [
    {
      "@type": "ContactPoint",
      "telephone": "+57-606-352-6161",
      "contactType": "sales",
      "email": "comercial@metromedicslab.com.co",
      "availableLanguage": ["Spanish"]
    }
  ],
  "sameAs": [
    "https://www.facebook.com/metromedics",
    "https://www.instagram.com/metromedics"
  ]
};

// WebSite schema (for Google Search site name)
const websiteSchema = {
  "@type": "WebSite",
  "@id": `${SITE_URL}/#website`,
  "name": SITE_NAME,
  "alternateName": "Metromedics",
  "url": SITE_URL,
  "inLanguage": "es-CO",
  "publisher": { "@id": `${SITE_URL}/#organization` },
};

// BreadcrumbList schema: Inicio > section (when it has its own page) > page.
// Not emitted on the homepage, where it would only repeat itself.
const sectionNames: Record<string, string> = { blog: "Blog", mantenimiento: "Mantenimiento" };
const segments = Astro.url.pathname.split("/").filter(Boolean);
const crumbs = [{ name: "Inicio", item: `${SITE_URL}/` }];
if (segments.length > 1 && sectionNames[segments[0]]) {
  crumbs.push({ name: sectionNames[segments[0]], item: `${SITE_URL}/${segments[0]}/` });
}
if (segments.length > 0) crumbs.push({ name: pageName, item: canonicalUrl });
const breadcrumbSchema = segments.length > 0 && {
  "@type": "BreadcrumbList",
  "@id": `${canonicalUrl}#breadcrumb`,
  "itemListElement": crumbs.map((c, i) => ({ "@type": "ListItem", "position": i + 1, ...c })),
};

const webPageSchema = {
  "@type": "WebPage",
  "@id": `${canonicalUrl}#webpage`,
  "url": canonicalUrl,
  "name": title,
  "description": description,
  "inLanguage": "es-CO",
  "isPartOf": { "@id": `${SITE_URL}/#website` },
  "about": { "@id": `${SITE_URL}/#organization` },
  "primaryImageOfPage": { "@type": "ImageObject", "url": imageUrl },
  ...(breadcrumbSchema && { "breadcrumb": { "@id": `${canonicalUrl}#breadcrumb` } }),
  ...(publishedTime && { "datePublished": publishedTime }),
  ...(pageModified && { "dateModified": pageModified }),
};

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [websiteSchema, organizationSchema, webPageSchema, breadcrumbSchema].filter(Boolean),
};

const pixelId = import.meta.env.PUBLIC_FACEBOOK_PIXEL_ID;
const gaId = import.meta.env.PUBLIC_GOOGLE_ANALYTICS_ID;
const posthogKey = import.meta.env.PUBLIC_POSTHOG_KEY;
const posthogHost = import.meta.env.PUBLIC_POSTHOG_HOST || "https://us.i.posthog.com";
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="author" content={type === "article" ? "Equipo técnico de Metromedics SAS" : SITE_NAME} />
    <link rel="author" href={`${SITE_URL}/nosotros/`} />
    <meta name="robots" content={noindex ? "noindex, follow" : "index, follow, max-image-preview:large, max-snippet:-1"} />
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
    <link rel="alternate" type="text/plain" title="llms.txt" href="/llms.txt" />
    {!noindex && Astro.url.pathname.endsWith("/") && (
      <link rel="alternate" type="text/markdown" href={`${canonicalUrl}index.md`} />
    )}
    <!-- Open Graph -->
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content="es_CO" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageUrl} />
    {imageUrl === DEFAULT_IMAGE && (
      <>
        <meta property="og:image:type" content="image/jpeg" />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
      </>
    )}
    <meta property="og:image:alt" content={pageName} />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    {type === "article" && <meta property="article:publisher" content="https://www.facebook.com/metromedics" />}
    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <!-- Favicon declarations -->
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="192x192" href="/images/favicon-1.png" />
    <link rel="apple-touch-icon" href="/images/favicon-1.png" />
    <meta name="apple-mobile-web-app-title" content="Metromedics SAS" />
    <meta name="application-name" content="Metromedics SAS" />
    <meta name="msapplication-TileImage" content="/images/favicon-1.png" />
    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <slot name="head" />

    {pixelId && (
        <script is:inline data-pixel-id={pixelId}>
          var pid = document.currentScript.dataset.pixelId;
          !function(f,b,e,v,n,t,s)
          {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
          n.callMethod.apply(n,arguments):n.queue.push(arguments)};
          if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
          n.queue=[];t=b.createElement(e);t.async=!0;
          t.src=v;s=b.getElementsByTagName(e)[0];
          s.parentNode.insertBefore(t,s)}(window, document,'script',
          'https://connect.facebook.net/en_US/fbevents.js');
          fbq('init', pid);
          fbq('track', 'PageView');
        </script>
    )}

    {gaId && (
      <>
        <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`}></script>
        <script is:inline data-ga-id={gaId}>
          var gid = document.currentScript.dataset.gaId;
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag('js', new Date());
          gtag('config', gid);
        </script>
      </>
    )}

    {posthogKey && (
      <script is:inline data-ph-key={posthogKey} data-ph-host={posthogHost}>
        var phKey = document.currentScript.dataset.phKey;
        var phHost = document.currentScript.dataset.phHost;
        !function(t,e){var o,n,p,r;e.__SV||(window.posthog=e,e._i=[],e.init=function(i,s,a){function g(t,e){var o=e.split(".");2==o.length&&(t=t[o[0]],e=o[1]),t[e]=function(){t.push([e].concat(Array.prototype.slice.call(arguments,0)))}}(p=t.createElement("script")).type="text/javascript",p.crossOrigin="anonymous",p.async=!0,p.src=s.api_host.replace(".i.posthog.com","-assets.i.posthog.com")+"/static/array.js",(r=t.getElementsByTagName("script")[0]).parentNode.insertBefore(p,r);var u=e;for(void 0!==a?u=e[a]=[]:a="posthog",u.people=u.people||[],u.toString=function(t){var e="posthog";return"posthog"!==a&&(e+="."+a),t||(e+=" (stub)"),e},u.people.toString=function(){return u.toString(1)+".people (stub)"},o="init capture register register_once register_for_session unregister unregister_for_session getFeatureFlag getFeatureFlagPayload isFeatureEnabled reloadFeatureFlags updateEarlyAccessFeatureEnrollment getEarlyAccessFeatures on onFeatureFlags onSessionId getSurveys getActiveMatchingSurveys renderSurvey canRenderSurvey getNextSurveyStep identify setPersonProperties group resetGroups setPersonPropertiesForFlags resetPersonPropertiesForFlags setGroupPropertiesForFlags resetGroupPropertiesForFlags reset get_distinct_id getGroups get_session_id get_session_replay_url alias set_config startSessionRecording stopSessionRecording sessionRecordingStarted captureException loadToolbar get_property getSessionProperty createPersonProfile opt_in_capturing opt_out_capturing has_opted_in_capturing has_opted_out_capturing clear_opt_in_out_capturing debug getPageViewId captureTraceFeedback captureTraceMetric".split(" "),n=0;n<o.length;n++)g(u,o[n]);e._i.push([i,s,a])},e.__SV=1)}(document,window.posthog||[]);
        posthog.init(phKey, {
          api_host: phHost,
          capture_pageview: true,
          autocapture: true,
          enable_heatmaps: true,
          person_profiles: 'always'
        });
        // Shared project with the internal app — tag every marketing-site
        // event so the two datasets can be filtered apart (site = "marketing").
        posthog.register({ site: 'marketing' });
      </script>
    )}

    <!-- Google Tag Manager -->
    <script is:inline>
      (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
      new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
      j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
      'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
      })(window,document,'script','dataLayer','GTM-MB52DKRX');
    </script>
    <!-- End Google Tag Manager -->
  </head>
  <body>
    <!-- Google Tag Manager (noscript) -->
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-MB52DKRX"
      height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <!-- End Google Tag Manager (noscript) -->
    {/* Facebook Pixel (noscript): must live in the body; an img inside the head
        makes the Astro compiler drop the body tag from the output. */}
    {pixelId && (
      <noscript><img height="1" width="1" style="display:none" alt=""
        src={`https://www.facebook.com/tr?id=${pixelId}&ev=PageView&noscript=1`}
      /></noscript>
    )}
    <Header />
    <main id="mainContent" class="mx-auto mt-[87px]">
      <slot />
    </main>
    <Footer />
    <WhatsAppFloat phoneNumber="573012541543" />
    {import.meta.env.PUBLIC_LEAD_MAGNET_ENABLED !== "false" && <LeadMagnetModal />}

    <!-- <Copyright /> -->
    <script is:inline>
      if ('serviceWorker' in navigator) {
        navigator.serviceWorker.getRegistrations().then(function(registrations) {
          for(let registration of registrations) {
            registration.unregister();
          }
        });
      }
    </script>
  </body>
</html>
