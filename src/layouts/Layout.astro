---
interface Props {
  title: string;
  description: string;
}
import { SEOMetadata } from "astro-seo-metadata";
import Copyright from "../components/landing/Copyright.astro";
import Footer from "../components/landing/Footer.astro";
import Header from "../components/landing/Header.astro";
import WhatsAppFloat from "../components/ui/WhatsAppFloat.astro";

import "../styles/Layout.css";

const { title, description } = Astro.props;

// JSON-LD Structured Data for Organization
const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "Metromedics SAS",
  "url": "https://metromedics.co",
  "logo": "https://metromedics.co/images/Logo-pagina-web.png",
  "description": "Calibración y mantenimiento de equipos médicos e industriales. Laboratorio acreditado ONAC bajo ISO/IEC 17025:2017.",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "Calle 35 13-46 Guadalupe",
    "addressLocality": "Dosquebradas",
    "addressRegion": "Risaralda",
    "addressCountry": "CO"
  },
  "contactPoint": [
    {
      "@type": "ContactPoint",
      "telephone": "+57-606-352-6161",
      "contactType": "sales",
      "email": "comercial@metromedicslab.com.co",
      "availableLanguage": ["Spanish"]
    }
  ],
  "sameAs": [
    "https://www.facebook.com/metromedics",
    "https://www.instagram.com/metromedics"
  ]
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <SEOMetadata
      siteName={`Metromedics SAS`}
      title={title}
      description={description}
      image={"https://metromedics.co/images/Logo-pagina-web.png"}
      favicon={"/images/favicon-1.png"}
      author="Jorge Betancur"
      copyright="ISC"
      astroSitemap={true}
      canonicalUrl={Astro.url.toString()}
      type={"website"}
      astroGenerator={true}
    />
    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
  </head>
  <body>
    <Header />
    <main id="mainContent" class="mx-auto mt-[87px]">
      <slot />
    </main>
    <Footer />
    <WhatsAppFloat phoneNumber="573001234567" />

    <!-- <Copyright /> -->
    <script is:inline>
      if ('serviceWorker' in navigator) {
        navigator.serviceWorker.getRegistrations().then(function(registrations) {
          for(let registration of registrations) {
            registration.unregister();
          }
        });
      }
    </script>
  </body>
</html>
