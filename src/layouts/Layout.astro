---
interface Props {
  title: string;
  description: string;
}
import { SEOMetadata } from "astro-seo-metadata";
import Copyright from "../components/landing/Copyright.astro";
import Footer from "../components/landing/Footer.astro";
import Header from "../components/landing/Header.astro";
import WhatsAppFloat from "../components/ui/WhatsAppFloat.astro";
import LeadMagnetModal from "../components/ui/LeadMagnetModal.astro";

import "../styles/Layout.css";

const { title, description } = Astro.props;

// JSON-LD Structured Data
const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "Metromedics SAS",
  "url": "https://metromedics.co",
  "logo": "https://metromedics.co/images/Logo-pagina-web.png",
  "description": "Calibración y mantenimiento de equipos médicos e industriales. Laboratorio acreditado ONAC bajo ISO/IEC 17025:2017.",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "Calle 35 13-46 Guadalupe",
    "addressLocality": "Dosquebradas",
    "addressRegion": "Risaralda",
    "addressCountry": "CO"
  },
  "contactPoint": [
    {
      "@type": "ContactPoint",
      "telephone": "+57-606-352-6161",
      "contactType": "sales",
      "email": "comercial@metromedicslab.com.co",
      "availableLanguage": ["Spanish"]
    }
  ],
  "sameAs": [
    "https://www.facebook.com/metromedics",
    "https://www.instagram.com/metromedics"
  ]
};

// BreadcrumbList schema
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Inicio", "item": "https://metromedics.co" },
    { "@type": "ListItem", "position": 2, "name": title, "item": Astro.url.toString() }
  ]
};

const pixelId = import.meta.env.PUBLIC_FACEBOOK_PIXEL_ID;
const gaId = import.meta.env.PUBLIC_GOOGLE_ANALYTICS_ID;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <SEOMetadata
      siteName={`Metromedics SAS`}
      title={title}
      description={description}
      image={"https://metromedics.co/images/Logo-pagina-web.png"}
      favicon={"/images/favicon-1.png"}
      author="Jorge Betancur"
      copyright="ISC"
      astroSitemap={true}
      canonicalUrl={Astro.url.toString()}
      type={"website"}
      astroGenerator={true}
    />
    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

    {pixelId && (
      <>
        <script is:inline data-pixel-id={pixelId}>
          var pid = document.currentScript.dataset.pixelId;
          !function(f,b,e,v,n,t,s)
          {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
          n.callMethod.apply(n,arguments):n.queue.push(arguments)};
          if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
          n.queue=[];t=b.createElement(e);t.async=!0;
          t.src=v;s=b.getElementsByTagName(e)[0];
          s.parentNode.insertBefore(t,s)}(window, document,'script',
          'https://connect.facebook.net/en_US/fbevents.js');
          fbq('init', pid);
          fbq('track', 'PageView');
        </script>
        <noscript><img height="1" width="1" style="display:none"
          src={`https://www.facebook.com/tr?id=${pixelId}&ev=PageView&noscript=1`}
        /></noscript>
      </>
    )}

    {gaId && (
      <>
        <script is:inline src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`}></script>
        <script is:inline data-ga-id={gaId}>
          var gid = document.currentScript.dataset.gaId;
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag('js', new Date());
          gtag('config', gid);
        </script>
      </>
    )}
  </head>
  <body>
    <Header />
    <main id="mainContent" class="mx-auto mt-[87px]">
      <slot />
    </main>
    <Footer />
    <WhatsAppFloat phoneNumber="573012541543" />
    {import.meta.env.PUBLIC_LEAD_MAGNET_ENABLED !== "false" && <LeadMagnetModal />}

    <!-- <Copyright /> -->
    <script is:inline>
      if ('serviceWorker' in navigator) {
        navigator.serviceWorker.getRegistrations().then(function(registrations) {
          for(let registration of registrations) {
            registration.unregister();
          }
        });
      }
    </script>
  </body>
</html>
