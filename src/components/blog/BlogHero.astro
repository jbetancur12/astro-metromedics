---
export interface Props {
  gradient: string;
  icon: string;
  date: string;
  readTime: string;
  title: string;
  subtitle: string;
  category: string;
}
const { gradient, icon, date, readTime, title, subtitle, category } = Astro.props;
---
<section class={`bg-gradient-to-br ${gradient} text-white relative overflow-hidden`}>
  <div class="absolute inset-0 opacity-[0.04]" style="background-image: repeating-linear-gradient(45deg, transparent, transparent 20px, rgba(255,255,255,0.3) 20px, rgba(255,255,255,0.3) 21px);"></div>
  <div class="absolute inset-0 opacity-[0.06]" style="background-image: radial-gradient(circle at 50px 50px, white 1px, transparent 0); background-size: 100px 100px;"></div>
  <div class="absolute top-0 right-0 w-96 h-96 bg-white/5 rounded-full blur-3xl -translate-y-1/2 translate-x-1/4"></div>
  <div class="absolute bottom-0 left-0 w-64 h-64 bg-white/5 rounded-full blur-3xl translate-y-1/3 -translate-x-1/4"></div>
  <div class="relative z-10 container mx-auto px-4">
    <div class="max-w-4xl mx-auto text-center py-20 md:py-28">
      <div class="flex items-center justify-center gap-3 mb-6">
        <span class="bg-white/15 backdrop-blur-sm text-white text-xs font-semibold px-3 py-1.5 rounded-full border border-white/10">{category}</span>
        <span class="text-white/60">·</span>
        <p class="text-sm text-white/70 tracking-wider uppercase font-medium">{date} · {readTime} de lectura</p>
      </div>
      <div class="relative inline-flex mb-8">
        <div class="w-16 h-16 bg-white/15 backdrop-blur-sm rounded-2xl flex items-center justify-center border border-white/10 shadow-lg">
          <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d={icon}></path></svg>
        </div>
        <div class="absolute -inset-4 bg-white/10 rounded-full blur-xl -z-10"></div>
      </div>
      <h1 class="text-display-lg font-bold mb-6 leading-tight">{title}</h1>
      <p class="text-xl text-white/80 leading-relaxed max-w-3xl mx-auto">{subtitle}</p>
    </div>
  </div>
</section>
