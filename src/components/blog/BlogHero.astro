---
export interface Props {
  gradient?: string;
  icon: string;
  date: string;
  readTime: string;
  title: string;
  subtitle: string;
  category: string;
}
const { icon, date, readTime, title, subtitle, category } = Astro.props;
---
<section class="bg-ink text-white">
  <div class="mx-auto max-w-[1240px] px-6">
    <div class="max-w-4xl py-20 md:py-24">
      <div class="flex flex-wrap items-center gap-x-4 gap-y-2">
        <span class="h-px w-10 bg-primary-500" aria-hidden="true"></span>
        <span class="text-xs font-medium tracking-[0.3em] text-primary-500">{category.toUpperCase()}</span>
        <span class="text-xs tracking-wider text-white/60">{date} · {readTime} de lectura</span>
      </div>
      <svg class="mt-8 h-9 w-9 text-primary-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.4" d={icon}></path></svg>
      <h1 class="mt-6 text-[clamp(32px,4.4vw,52px)] leading-[1.1]">{title}</h1>
      <p class="mt-6 max-w-3xl text-lg leading-relaxed text-white/90">{subtitle}</p>
    </div>
  </div>
</section>
