---
export interface Props {
  currentSlug: string;
  category: string;
}

const { currentSlug, category } = Astro.props;

const allArticles = [
  { slug: "calibracion-basculas-balanzas-comercio-sic-oiml", title: "Calibración de básculas y balanzas para comercio", category: "Normativa", gradient: "from-medical-blue to-primary-600", icon: "M3 6l3 1m0 0l-3 9a5.002 5.002 0 006.001 0M6 7l3 9M6 7l6-2m6 2l3-1m-3 1l-3 9a5.002 5.002 0 006.001 0M18 7l3 9m-3-9l-6-2m0-2v2m0 16V5m0 16H9m3 0h3" },
  { slug: "preparar-auditoria-iso-9001-calibracion", title: "Cómo preparar sus equipos para una auditoría ISO 9001", category: "Guías", gradient: "from-medical-blue to-primary-600", icon: "M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4" },
  { slug: "calibracion-industria-alimentaria-bpm-haccp", title: "Calibración en la industria alimentaria: requisitos INVIMA", category: "Calibración", gradient: "from-medical-blue to-primary-600", icon: "M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4" },
  { slug: "validacion-autoclaves-central-esterilizacion-iq-oq-pq", title: "Validación de autoclaves: IQ, OQ, PQ paso a paso", category: "Validación", gradient: "from-medical-blue to-primary-600", icon: "M20.618 5.984A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016zM12 9v2m0 4h.01" },
  { slug: "calibracion-vs-mantenimiento-equipos-biomedicos", title: "Calibración vs mantenimiento de equipos biomédicos", category: "Guías", gradient: "from-medical-blue to-primary-600", icon: "M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4m0 5c0 2.21-3.582 4-8 4s-8-1.79-8-4" },
  { slug: "resolucion-3100-2019-calibracion-ips", title: "Resolución 3100 de 2019: guía de calibración para IPS", category: "Normativa", gradient: "from-medical-blue to-primary-600", icon: "M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" },
  { slug: "calibracion-equipos-medicos-obligatoria-colombia", title: "Calibración obligatoria de equipos en Colombia", category: "Calibración", gradient: "from-medical-blue to-primary-600", icon: "M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" },
  { slug: "iso-17025-calibracion-acreditada-empresas-colombia", title: "ISO/IEC 17025: calibración acreditada para su empresa", category: "Normativa", gradient: "from-medical-blue to-primary-600", icon: "M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z" },
  { slug: "mantenimiento-preventivo-equipos-industriales-hospitalarios", title: "Mantenimiento preventivo de equipos industriales y hospitalarios", category: "Mantenimiento", gradient: "from-medical-blue to-primary-600", icon: "M4 5a1 1 0 011-1h14a1 1 0 011 1v2a1 1 0 01-1 1H5a1 1 0 01-1-1V5zM4 11a1 1 0 011-1h14a1 1 0 011 1v2a1 1 0 01-1 1H5a1 1 0 01-1-1v-2zM4 17a1 1 0 011-1h14a1 1 0 011 1v2a1 1 0 01-1 1H5a1 1 0 01-1-1v-2z" },
  { slug: "validacion-autoclaves-requisitos-normativos", title: "Validación de autoclaves: requisitos normativos", category: "Validación", gradient: "from-medical-blue to-primary-600", icon: "M13 10V3L4 14h7v7l9-11h-7z" },
  { slug: "frecuencias-calibracion-equipos-medicion", title: "Frecuencias de calibración de equipos de medición", category: "Guías", gradient: "from-medical-blue to-primary-600", icon: "M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" },
];

const related = allArticles
  .filter(a => a.slug !== currentSlug && a.category === category)
  .slice(0, 3);
---

{
  related.length > 0 && (
    <section class="py-16 bg-gray-50 border-t border-gray-100">
      <div class="container mx-auto px-4">
        <div class="max-w-6xl mx-auto">
          <h2 class="text-2xl font-bold text-gray-900 mb-8">Artículos relacionados</h2>
          <div class="grid md:grid-cols-3 gap-6">
            {related.map(article => (
              <a
                href={`/blog/${article.slug}`}
                class="group bg-white rounded-xl overflow-hidden shadow-md hover:shadow-lg transition-all duration-300 flex flex-col"
              >
                <div class={`bg-gradient-to-br ${article.gradient} p-5 min-h-[100px] flex items-end relative overflow-hidden`}>
                  <div class="w-10 h-10 bg-white/10 rounded-xl flex items-center justify-center">
                    <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={article.icon}></path>
                    </svg>
                  </div>
                </div>
                <div class="p-5 flex-1">
                  <h3 class="text-base font-semibold text-gray-900 mb-2 group-hover:text-medical-blue transition-colors line-clamp-2">
                    {article.title}
                  </h3>
                  <span class="text-medical-blue text-sm font-medium flex items-center gap-1 group-hover:gap-2 transition-all">
                    Leer artículo
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
                    </svg>
                  </span>
                </div>
              </a>
            ))}
          </div>
        </div>
      </div>
    </section>
  )
}
