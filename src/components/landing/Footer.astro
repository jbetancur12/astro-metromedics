---
import Wordmark from "./Wordmark.astro";

const links = [
  { href: "/", label: "Inicio" },
  { href: "/servicios", label: "Servicios" },
  { href: "/nosotros", label: "Nosotros" },
  { href: "/blog", label: "Blog" },
  { href: "/contacto", label: "Contacto" },
  { href: "/evaluacion-servicio", label: "Evaluación de servicio" },
  { href: "/pqr", label: "PQR" },
  { href: "/politica-datos", label: "Política de datos" },
];
---

<footer class="bg-ink-900 text-white/75">
  <div class="mx-auto max-w-[1240px] px-6 pb-8 pt-16">
    <div class="grid gap-12 lg:grid-cols-[1.3fr_1fr_1.2fr]">
      <div class="flex flex-col gap-5">
        <a href="/" aria-label="Metromedics, inicio" class="w-fit text-[22px] text-white no-underline hover:text-white" style="--wm-needle:#00bfa5">
          <Wordmark />
        </a>
        <p class="max-w-sm text-[15px] leading-relaxed">
          Ingeniería y laboratorio de metrología. Calibración y mantenimiento de equipos médicos e industriales, con más de 10 años de experiencia.
        </p>
        <p class="text-[13px] tracking-wide text-white/90">ISO/IEC 17025:2017 · ONAC 18-LAC-020</p>
        <div class="mt-1 flex gap-3">
          <a
            href="https://www.facebook.com/metromedics.sas/"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Síguenos en Facebook"
            class="flex h-11 w-11 items-center justify-center rounded-full border border-white/25 text-white transition-colors hover:border-primary-500 hover:text-primary-300"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 3h-2a4 4 0 0 0-4 4v3H7v4h2v7h4v-7h3l1-4h-4V7a1 1 0 0 1 1-1h2Z"></path></svg>
          </a>
          <a
            href="https://www.instagram.com/metromedics"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Síguenos en Instagram"
            class="flex h-11 w-11 items-center justify-center rounded-full border border-white/25 text-white transition-colors hover:border-primary-500 hover:text-primary-300"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"></rect><circle cx="12" cy="12" r="4"></circle><path d="M17.5 6.5h.01"></path></svg>
          </a>
        </div>
      </div>

      <nav aria-label="Pie de página">
        <h2 class="text-xs font-semibold tracking-[0.24em] text-white/65">NAVEGACIÓN</h2>
        <ul class="mt-5 grid grid-cols-2 gap-x-8 gap-y-3 text-sm">
          {links.map((l) => (
            <li><a href={l.href} class="text-white/80 no-underline transition-colors hover:text-primary-300">{l.label}</a></li>
          ))}
        </ul>
      </nav>

      <div>
        <h2 class="text-xs font-semibold tracking-[0.24em] text-white/65">CONTACTO</h2>
        <address class="mt-5 flex flex-col gap-5 text-sm not-italic leading-relaxed">
          <div>
            <div class="font-medium text-white">Dosquebradas</div>
            Calle 35 13-46, Guadalupe<br />
            <a href="tel:+576063526161" class="text-white/80 no-underline hover:text-primary-300">(+57) 606 352 6161</a>
          </div>
          <div>
            <div class="font-medium text-white">Bogotá</div>
            Cra. 71C #52-34, Oficina 101<br />
            <a href="tel:+573008163096" class="text-white/80 no-underline hover:text-primary-300">300 816 3096</a>
          </div>
          <div>
            <div class="font-medium text-white">WhatsApp</div>
            <a href="https://wa.me/573012541543" class="text-white/80 no-underline hover:text-primary-300">301 254 1543</a> ·
            <a href="https://wa.me/573113441682" class="text-white/80 no-underline hover:text-primary-300">311 344 1682</a>
          </div>
          <a href="mailto:comercial@metromedicslab.com.co" class="text-white/80 no-underline hover:text-primary-300">comercial@metromedicslab.com.co</a>
        </address>
      </div>
    </div>

    <div class="mt-14 flex flex-wrap justify-between gap-x-8 gap-y-3 border-t border-white/10 pt-6 text-xs text-white/60">
      <span>© {new Date().getFullYear()} Metromedics S.A.S. Todos los derechos reservados.</span>
      <span>
        Desarrollo web:
        <a href="https://jorgebetancur.dev" target="_blank" rel="noopener" class="text-white/80 no-underline hover:text-primary-300">Jorge Betancur</a>
        ·
        <a href="mailto:jabetancur12@gmail.com" class="text-white/60 no-underline hover:text-primary-300">jabetancur12@gmail.com</a>
        ·
        <a href="tel:+573138124282" class="text-white/60 no-underline hover:text-primary-300">+57 313 812 4282</a>
      </span>
    </div>
  </div>
</footer>
