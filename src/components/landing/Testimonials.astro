---
const testimonials = [
  {
    quote: "Metromedics nos ha brindado un servicio de calibración excepcional para nuestros equipos médicos. Su certificación ONAC nos da la tranquilidad que necesitamos en el sector salud.",
    name: "Dr. Ricardo Martínez",
    role: "Director Médico · Clínica Dosquebradas",
  },
  {
    quote: "El mantenimiento preventivo que Metromedics realiza a nuestros equipos industriales ha reducido significativamente los tiempos de inactividad no planificada.",
    name: "Ana Pérez",
    role: "Jefe de Mantenimiento · Industrias del Café",
  },
  {
    quote: "Metromedics nos ayudó a preparar todos nuestros equipos de medición para la auditoría de certificación ISO 9001. Pasamos sin ninguna no conformidad y redujimos nuestras paradas no planificadas en un 40% gracias a su programa de mantenimiento preventivo.",
    name: "Pedro Galindo",
    role: "Gerente de Producción · Industrias del Café S.A.S.",
  },
];
---

<section class="bg-white">
  <div class="mx-auto max-w-[1240px] px-6 pb-24 lg:pb-28">
    <span class="text-xs font-semibold tracking-[0.3em] text-primary-800">CLIENTES</span>
    <h2 class="mt-4 max-w-[760px] text-[clamp(30px,3.4vw,42px)] font-light leading-[1.15] tracking-[-0.015em] text-ink">
      Más de 500 empresas confían en nuestras mediciones.
    </h2>

    <div class="mt-12 grid gap-6 md:grid-cols-3">
      {testimonials.map((t) => (
        <figure class="m-0 flex flex-col gap-6 bg-paper p-8">
          <blockquote class="m-0 text-[17px] font-light leading-relaxed text-gray-900">“{t.quote}”</blockquote>
          <figcaption class="mt-auto">
            <div class="text-[15px] font-semibold text-ink">{t.name}</div>
            <div class="text-[13px] text-gray-600">{t.role}</div>
          </figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>
