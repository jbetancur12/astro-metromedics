---
const features = [
  { title: "Acreditación ONAC 18-LAC-020", text: "Bajo la norma ISO/IEC 17025:2017." },
  { title: "Equipos de precisión", text: "Tecnología calibrada con patrones trazables a NIST." },
  { title: "Personal especializado", text: "Técnicos certificados con más de 10 años de experiencia." },
];
---

<section id="laboratorio" class="bg-ink text-white">
  <div class="mx-auto max-w-[1240px] px-6 py-24 lg:py-28">
    <div class="flex flex-wrap items-end justify-between gap-x-14 gap-y-6">
      <div class="max-w-[560px]">
        <span class="text-xs font-medium tracking-[0.3em] text-primary-500">NUESTRO LABORATORIO</span>
        <h2 class="mt-4 text-[clamp(30px,3.4vw,42px)] font-light leading-[1.15] tracking-[-0.015em]">
          Patrones trazables, condiciones controladas y técnicos certificados.
        </h2>
      </div>
      <p class="max-w-[400px] text-base leading-relaxed text-white/75">
        Más de 10 años de experiencia calibrando equipos para el sector salud y la industria.
      </p>
    </div>

    <div class="mt-14 grid items-center gap-12 lg:grid-cols-[1.35fr_1fr]">
      <div class="aspect-video overflow-hidden rounded-sm bg-ink-700">
        <video
          controls
          preload="none"
          poster="/images/companymmcs.jpg"
          class="h-full w-full object-cover"
          aria-label="Video institucional de Metromedics"
        >
          <source src="/videos/companymmcs.mp4" type="video/mp4" />
          Su navegador no soporta el elemento de video.
        </video>
      </div>

      <div class="flex flex-col gap-8">
        <ul class="flex flex-col">
          {features.map((f, i) => (
            <li class="flex gap-5 border-t border-white/15 py-5 last:border-b">
              <span class="pt-0.5 text-xs tracking-[0.2em] text-primary-500">0{i + 1}</span>
              <div>
                <h3 class="text-lg font-medium">{f.title}</h3>
                <p class="mt-1 text-[15px] leading-relaxed text-white/70">{f.text}</p>
              </div>
            </li>
          ))}
        </ul>
        <div class="flex flex-wrap gap-4">
          <a href="/contacto" class="rounded-sm bg-primary-500 px-7 py-4 text-xs font-semibold tracking-[0.18em] text-ink no-underline transition-colors hover:bg-primary-300 hover:text-ink">AGENDAR VISITA</a>
          <a href="/laboratorios/laboratorio-acreditado" class="rounded-sm border border-white/45 px-7 py-[15px] text-xs font-medium tracking-[0.18em] text-white no-underline transition-colors hover:border-white hover:text-white">VER EL LABORATORIO</a>
        </div>
      </div>
    </div>
  </div>
</section>
