---
import Wordmark from "./Wordmark.astro";

const pathname = Astro.url.pathname;
const isActive = (href: string) => pathname === href || pathname === `${href}/`;

const navLinks = [
  { href: "/servicios", label: "Servicios" },
  { href: "/nosotros", label: "Nosotros" },
  { href: "/blog", label: "Blog" },
];

const labLinks = [
  { href: "/laboratorios/laboratorio-acreditado", label: "Laboratorio acreditado" },
  { href: "/laboratorios/laboratorio-con-trazabilidad-sector-biomedico-e-industrial", label: "Laboratorio con trazabilidad" },
];

const portalLinks = [
  { href: "https://app.metromedicslab.com/login", label: "Calibraciones", external: true },
  { href: "/mantenimiento", label: "Tickets de mantenimiento", external: false },
  { href: "https://fm34.easytechpro.com/fmi/webd", label: "Mantenimiento", external: true },
];

const linkBase =
  "block whitespace-nowrap py-3 text-[13px] font-medium tracking-[0.06em] no-underline transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-primary-500";
---

<!-- Franja superior: contacto y atención al cliente -->
<div class="bg-ink-900 text-white/75 text-xs tracking-[0.04em]">
  <div class="mx-auto flex max-w-[1240px] flex-wrap items-center justify-between gap-x-6 gap-y-1 px-6 py-2.5">
    <span class="hidden sm:inline">Dosquebradas · Bogotá · Lun–Vie 8:00 a. m. – 6:00 p. m.</span>
    <div class="flex flex-wrap items-center gap-x-6 gap-y-1">
      <a href="tel:+576063526161" class="text-white/85 no-underline hover:text-white">(+57) 606 352 6161</a>
      <a href="https://wa.me/573012541543" class="hidden text-white/85 no-underline hover:text-white md:inline">WhatsApp 301 254 1543</a>
      <span aria-hidden="true" class="hidden text-white/30 sm:inline">|</span>
      <a href="/evaluacion-servicio" class="font-semibold text-white no-underline hover:text-primary-300">Evaluar servicio</a>
      <a href="/pqr" class="font-semibold text-white no-underline hover:text-primary-300">PQR</a>
    </div>
  </div>
</div>

<header id="header" class="sticky top-0 z-50 border-b border-white/10 bg-ink text-white">
  <div class="mx-auto flex min-h-[76px] max-w-[1240px] items-center justify-between gap-6 px-6">
    <a
      href="/"
      aria-label="Metromedics, inicio"
      class="py-4 text-lg text-white no-underline hover:text-white focus:outline-none focus-visible:ring-2 focus-visible:ring-primary-500"
      style="--wm-needle:#00bfa5"
    >
      <Wordmark />
    </a>

    <button
      id="nav-toggle"
      class="flex min-h-[44px] min-w-[44px] items-center justify-center rounded-sm text-white focus:outline-none focus-visible:ring-2 focus-visible:ring-primary-500 lg:hidden"
      aria-label="Abrir menú de navegación"
      aria-expanded="false"
      aria-controls="burgerMenu"
    >
      <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
        <path d="M4 7h16M4 12h16M4 17h16"></path>
      </svg>
    </button>

    <nav aria-label="Principal" class="hidden items-center gap-x-6 lg:flex">
      <a
        href={navLinks[0].href}
        class:list={[linkBase, isActive(navLinks[0].href) ? "text-primary-300" : "text-white/85 hover:text-white"]}
        aria-current={isActive(navLinks[0].href) ? "page" : undefined}>{navLinks[0].label}</a
      >

      <div class="relative">
        <a
          id="laboratoriosLink"
          href={labLinks[0].href}
          class:list={[linkBase, "group flex items-center gap-1.5", pathname.startsWith("/laboratorios") ? "text-primary-300" : "text-white/85 hover:text-white"]}
          aria-expanded="false"
          aria-haspopup="true"
          aria-controls="laboratorios"
          role="button"
        >
          Laboratorios
          <svg class="h-3.5 w-3.5 transition-transform duration-200" viewBox="0 0 14 8" fill="none" aria-hidden="true">
            <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="m1 1 5.326 5.7a.909.909 0 0 0 1.348 0L13 1"></path>
          </svg>
        </a>
        <div id="laboratorios" class="absolute left-0 top-full z-20 mt-1 hidden w-72 rounded-sm border border-ink bg-white py-2 text-ink shadow-lg" role="menu" aria-labelledby="laboratoriosLink">
          {labLinks.map((l) => (
            <a href={l.href} role="menuitem" class="block px-5 py-3 text-sm font-medium text-ink no-underline hover:bg-paper hover:text-primary-800 focus:bg-paper focus:outline-none">{l.label}</a>
          ))}
        </div>
      </div>

      {navLinks.slice(1).map((l) => (
        <a
          href={l.href}
          class:list={[linkBase, isActive(l.href) || (l.href === "/blog" && pathname.startsWith("/blog")) ? "text-primary-300" : "text-white/85 hover:text-white"]}
          aria-current={isActive(l.href) ? "page" : undefined}>{l.label}</a
        >
      ))}

      <div class="relative">
        <a
          id="clientesLink"
          href="#"
          class:list={[linkBase, "group flex items-center gap-1.5 text-white/85 hover:text-white"]}
          aria-expanded="false"
          aria-haspopup="true"
          aria-controls="clientes"
          role="button"
        >
          Portal cliente
          <svg class="h-3.5 w-3.5 transition-transform duration-200" viewBox="0 0 14 8" fill="none" aria-hidden="true">
            <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="m1 1 5.326 5.7a.909.909 0 0 0 1.348 0L13 1"></path>
          </svg>
        </a>
        <div id="clientes" class="absolute right-0 top-full z-20 mt-1 hidden w-64 rounded-sm border border-ink bg-white py-2 text-ink shadow-lg" role="menu" aria-labelledby="clientesLink">
          {portalLinks.map((l) => (
            <a
              href={l.href}
              role="menuitem"
              class="flex items-center justify-between px-5 py-3 text-sm font-medium text-ink no-underline hover:bg-paper hover:text-primary-800 focus:bg-paper focus:outline-none"
              target={l.external ? "_blank" : undefined}
              rel={l.external ? "noopener noreferrer" : undefined}
            >
              {l.label}
              {l.external && (
                <svg class="h-3 w-3 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
                </svg>
              )}
            </a>
          ))}
        </div>
      </div>

      <a
        href="/contacto"
        class="rounded-sm bg-primary-500 px-5 py-3 text-xs font-semibold tracking-[0.16em] text-primary-900 no-underline transition-colors hover:bg-primary-300 hover:text-primary-900 focus:outline-none focus-visible:ring-2 focus-visible:ring-white"
      >COTIZAR</a>
    </nav>
  </div>

  <!-- Menú móvil -->
  <div id="burgerMenu" class="hidden max-h-[calc(100vh-7rem)] overflow-y-auto border-t border-white/10 bg-ink lg:hidden" role="menu" aria-labelledby="nav-toggle">
    <div class="mx-auto max-w-[1240px] px-6 py-4">
      <a href="/servicios" class="flex min-h-[48px] items-center border-b border-white/10 text-base text-white no-underline" role="menuitem">Servicios</a>

      <div class="border-b border-white/10">
        <button
          id="laboratoriosMobileLink"
          type="button"
          class="flex min-h-[48px] w-full items-center justify-between text-left text-base text-white"
          aria-expanded="false"
          aria-controls="laboratoriosMobile"
        >
          Laboratorios
          <svg class="h-4 w-4 transition-transform duration-200" viewBox="0 0 14 8" fill="none" aria-hidden="true">
            <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="m1 1 5.326 5.7a.909.909 0 0 0 1.348 0L13 1"></path>
          </svg>
        </button>
        <div id="laboratoriosMobile" class="mb-2 hidden border-l border-primary-500 pl-4">
          {labLinks.map((l) => (
            <a href={l.href} class="flex min-h-[44px] items-center text-sm text-white/80 no-underline hover:text-white">{l.label}</a>
          ))}
        </div>
      </div>

      <a href="/nosotros" class="flex min-h-[48px] items-center border-b border-white/10 text-base text-white no-underline" role="menuitem">Nosotros</a>
      <a href="/blog" class="flex min-h-[48px] items-center border-b border-white/10 text-base text-white no-underline" role="menuitem">Blog</a>
      <a href="/evaluacion-servicio" class="flex min-h-[48px] items-center border-b border-white/10 text-base text-white no-underline" role="menuitem">Evaluación de servicio</a>
      <a href="/pqr" class="flex min-h-[48px] items-center border-b border-white/10 text-base text-white no-underline" role="menuitem">PQR</a>

      <div class="border-b border-white/10">
        <button
          id="clientesMobileLink"
          type="button"
          class="flex min-h-[48px] w-full items-center justify-between text-left text-base text-white"
          aria-expanded="false"
          aria-controls="clientesMobile"
        >
          Portal cliente
          <svg class="h-4 w-4 transition-transform duration-200" viewBox="0 0 14 8" fill="none" aria-hidden="true">
            <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="m1 1 5.326 5.7a.909.909 0 0 0 1.348 0L13 1"></path>
          </svg>
        </button>
        <div id="clientesMobile" class="mb-2 hidden border-l border-primary-500 pl-4">
          {portalLinks.map((l) => (
            <a
              href={l.href}
              class="flex min-h-[44px] items-center text-sm text-white/80 no-underline hover:text-white"
              target={l.external ? "_blank" : undefined}
              rel={l.external ? "noopener noreferrer" : undefined}
            >{l.label}</a>
          ))}
        </div>
      </div>

      <a
        href="/contacto"
        class="mt-5 block rounded-sm bg-primary-500 px-6 py-4 text-center text-xs font-semibold tracking-[0.18em] text-primary-900 no-underline hover:bg-primary-300"
      >SOLICITAR COTIZACIÓN</a>
    </div>
  </div>
</header>

<script>
  // Desplegables con teclado: Enter/Espacio abre, flechas navegan, Escape cierra
  function setupDropdown(linkId: string, menuId: string, mobileMenuId: string) {
    const link = document.getElementById(linkId);
    const menu = document.getElementById(menuId);
    const mobileMenu = document.getElementById(mobileMenuId);
    if (!link || !menu) return;

    const setOpen = (open: boolean) => {
      link.setAttribute("aria-expanded", open ? "true" : "false");
      menu.classList.toggle("hidden", !open);
      const icon = link.querySelector("svg:last-child") as SVGElement | null;
      if (icon) icon.style.transform = open ? "rotate(180deg)" : "rotate(0deg)";
    };

    link.addEventListener("click", (e) => {
      e.preventDefault();
      const open = link.getAttribute("aria-expanded") !== "true";
      // Un solo desplegable abierto a la vez
      document.querySelectorAll<HTMLElement>('nav [aria-haspopup="true"][aria-expanded="true"]').forEach((el) => {
        if (el !== link) el.click();
      });
      setOpen(open);
    });

    link.addEventListener("keydown", (e) => {
      if (e.key === "Enter" || e.key === " ") {
        e.preventDefault();
        link.click();
      } else if (e.key === "Escape") {
        setOpen(false);
      } else if (e.key === "ArrowDown") {
        e.preventDefault();
        if (link.getAttribute("aria-expanded") !== "true") link.click();
        menu.querySelector<HTMLElement>('[role="menuitem"]')?.focus();
      }
    });

    menu.addEventListener("keydown", (e) => {
      const items = Array.from(menu.querySelectorAll<HTMLElement>('[role="menuitem"]'));
      const i = items.indexOf(document.activeElement as HTMLElement);
      if (e.key === "ArrowDown") {
        e.preventDefault();
        items[(i + 1) % items.length]?.focus();
      } else if (e.key === "ArrowUp") {
        e.preventDefault();
        items[(i - 1 + items.length) % items.length]?.focus();
      } else if (e.key === "Escape") {
        e.preventDefault();
        setOpen(false);
        link.focus();
      }
    });

    document.addEventListener("click", (e) => {
      const target = e.target as Node;
      if (!link.contains(target) && !menu.contains(target)) setOpen(false);
    });

    const mobileLink = document.getElementById(linkId.replace("Link", "MobileLink"));
    mobileLink?.addEventListener("click", () => {
      const open = mobileLink.getAttribute("aria-expanded") !== "true";
      mobileLink.setAttribute("aria-expanded", open ? "true" : "false");
      mobileMenu?.classList.toggle("hidden", !open);
      const icon = mobileLink.querySelector("svg:last-child") as SVGElement | null;
      if (icon) icon.style.transform = open ? "rotate(180deg)" : "rotate(0deg)";
    });
  }

  setupDropdown("laboratoriosLink", "laboratorios", "laboratoriosMobile");
  setupDropdown("clientesLink", "clientes", "clientesMobile");

  const navToggle = document.getElementById("nav-toggle");
  const burgerMenu = document.getElementById("burgerMenu");

  navToggle?.addEventListener("click", () => {
    const open = navToggle.getAttribute("aria-expanded") !== "true";
    navToggle.setAttribute("aria-expanded", open ? "true" : "false");
    burgerMenu?.classList.toggle("hidden", !open);
  });

  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && burgerMenu && !burgerMenu.classList.contains("hidden")) {
      navToggle?.setAttribute("aria-expanded", "false");
      burgerMenu.classList.add("hidden");
      navToggle?.focus();
    }
  });

  // Sombra al desplazarse
  const header = document.getElementById("header");
  document.addEventListener(
    "scroll",
    () => header?.classList.toggle("shadow-lg", window.scrollY > 10),
    { passive: true }
  );
</script>
