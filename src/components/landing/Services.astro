---
import { Picture } from "astro:assets";
import calibracion from "../../assets/images/home/servicio-calibracion.webp";
import autoclaves from "../../assets/images/home/servicio-autoclaves.webp";
import mantenimiento from "../../assets/images/home/servicio-mantenimiento.webp";

const services = [
  {
    n: "01",
    title: "Calibración acreditada",
    text: "ISO/IEC 17025:2017 con trazabilidad NIST, en laboratorio o en sitio. Acreditación ONAC 18-LAC-020.",
    img: calibracion,
    alt: "Calibración de equipos biomédicos",
    href: "https://www.calameo.com/read/007460758775f4141e5f8",
    cta: "VER PORTAFOLIO",
    external: true,
  },
  {
    n: "02",
    title: "Validación de autoclaves",
    text: "Calificación IQ, OQ y PQ por comparación directa y determinación del factor F, para autoclaves hospitalarios e industriales.",
    img: autoclaves,
    alt: "Autoclave en validación",
    href: "/servicios",
    cta: "VER SERVICIO",
    external: false,
  },
  {
    n: "03",
    title: "Mantenimiento especializado",
    text: "Preventivo y correctivo para equipos médicos, odontológicos e industriales, con respuesta oportuna ante fallas.",
    img: mantenimiento,
    alt: "Mantenimiento de equipos médicos",
    href: "/servicios",
    cta: "VER SERVICIO",
    external: false,
  },
];
---

<section id="servicios" class="bg-white">
  <div class="mx-auto max-w-[1240px] px-6 py-24 lg:py-28">
    <span class="text-xs font-semibold tracking-[0.3em] text-primary-800">SERVICIOS</span>
    <h2 class="mt-4 max-w-[640px] text-[clamp(30px,3.4vw,42px)] font-light leading-[1.15] tracking-[-0.015em] text-ink">
      Más que calibrar: validamos y mantenemos sus equipos.
    </h2>

    <div class="mt-14 grid gap-8 md:grid-cols-3">
      {services.map((s) => (
        <article class="flex flex-col gap-4">
          <div class="h-[240px] overflow-hidden rounded-sm bg-paper">
            <Picture src={s.img} formats={["avif", "webp"]} fallbackFormat="webp" widths={[400, 640, 800]} sizes="(min-width: 1024px) 400px, (min-width: 640px) 45vw, 100vw" alt={s.alt} class="h-full w-full object-cover" />
          </div>
          <span class="text-xs tracking-[0.2em] text-primary-800">{s.n}</span>
          <h3 class="text-[22px] font-medium text-ink">{s.title}</h3>
          <p class="text-[15px] leading-relaxed text-gray-600">{s.text}</p>
          <a
            href={s.href}
            target={s.external ? "_blank" : undefined}
            rel={s.external ? "noopener noreferrer" : undefined}
            class="mt-auto w-fit py-2 text-xs font-semibold tracking-[0.14em] text-primary-800 no-underline hover:text-ink"
          >{s.cta} →</a>
        </article>
      ))}
    </div>

    <div class="mt-14 flex flex-wrap items-center justify-between gap-6 border-t border-gray-200 pt-8">
      <p class="text-base text-gray-600">¿Necesita una cotización personalizada? Respondemos en menos de 24 horas hábiles.</p>
      <a href="/contacto" class="rounded-sm bg-ink px-7 py-4 text-xs font-semibold tracking-[0.18em] text-white no-underline transition-colors hover:bg-ink-700 hover:text-white">SOLICITAR COTIZACIÓN</a>
    </div>
  </div>
</section>
