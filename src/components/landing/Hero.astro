---
// Dial decorativo: marcas cada 6.75° sobre un arco de 270°, como el manómetro del logo
const ticks = Array.from({ length: 41 }, (_, i) => {
  const a = ((135 + i * 6.75) * Math.PI) / 180;
  const major = i % 5 === 0;
  const r1 = major ? 132 : 140;
  return {
    x1: 200 + Math.cos(a) * r1,
    y1: 200 + Math.sin(a) * r1,
    x2: 200 + Math.cos(a) * 150,
    y2: 200 + Math.sin(a) * 150,
    major,
  };
});
const needle = ((135 + 27 * 6.75) * Math.PI) / 180;
---

<section class="bg-ink text-white">
  <div class="mx-auto flex max-w-[1240px] flex-wrap items-stretch gap-12 px-6 pb-20 pt-16 lg:pb-24 lg:pt-20">
    <div class="flex min-w-0 flex-[1_1_460px] flex-col justify-center py-4">
      <div class="flex items-center gap-3.5">
        <span class="h-px w-10 bg-primary-500" aria-hidden="true"></span>
        <span class="text-xs font-medium tracking-[0.3em] text-primary-500">ACREDITADO ONAC · ISO/IEC 17025</span>
      </div>
      <h1 class="mt-7 text-[clamp(36px,4.6vw,58px)] font-light leading-[1.08] tracking-[-0.02em]">
        Calibración acreditada para equipos biomédicos e industriales.
      </h1>
      <p class="mt-6 max-w-[520px] text-lg leading-relaxed text-white/75">
        Laboratorio acreditado en masa, temperatura y presión, con patrones trazables a NIST y técnicos certificados.
      </p>
      <div class="mt-10 flex flex-wrap gap-4">
        <a href="/contacto" class="rounded-sm bg-primary-500 px-7 py-4 text-xs font-semibold tracking-[0.18em] text-ink no-underline transition-colors hover:bg-primary-300 hover:text-ink focus:outline-none focus-visible:ring-2 focus-visible:ring-white">SOLICITAR COTIZACIÓN</a>
        <a href="#magnitudes" class="rounded-sm border border-white/45 px-7 py-[15px] text-xs font-medium tracking-[0.18em] text-white no-underline transition-colors hover:border-white hover:text-white focus:outline-none focus-visible:ring-2 focus-visible:ring-white">VER ALCANCE ACREDITADO</a>
      </div>
    </div>

    <div class="relative min-w-0 flex-[1_1_460px]">
      <div class="flex h-[420px] items-center justify-center rounded-sm bg-ink-700 sm:h-[540px]" role="img" aria-label="Manómetro de precisión, símbolo de la marca">
        <svg viewBox="0 0 400 400" class="h-[88%] w-auto" aria-hidden="true">
          <circle cx="200" cy="200" r="176" fill="none" stroke="#ffffff" stroke-opacity="0.18" stroke-width="2"></circle>
          <circle cx="200" cy="200" r="166" fill="#072724" stroke="#ffffff" stroke-opacity="0.35" stroke-width="10"></circle>
          {ticks.map((t) => (
            <line x1={t.x1} y1={t.y1} x2={t.x2} y2={t.y2} stroke="#ffffff" stroke-opacity={t.major ? 0.85 : 0.4} stroke-width={t.major ? 3 : 1.5} stroke-linecap="round"></line>
          ))}
          <path d={`M200 200 L${200 + Math.cos(needle) * 118} ${200 + Math.sin(needle) * 118}`} stroke="#00bfa5" stroke-width="7" stroke-linecap="round"></path>
          <circle cx="200" cy="200" r="13" fill="#ffffff"></circle>
          <circle cx="200" cy="200" r="5" fill="#072724"></circle>
          <text x="200" y="290" text-anchor="middle" font-size="13" letter-spacing="4" fill="#ffffff" fill-opacity="0.6" font-family="Inter, sans-serif">ISO/IEC 17025</text>
        </svg>
      </div>
      <div class="absolute left-4 top-8 flex flex-col gap-1 rounded-sm bg-paper px-6 py-5 text-ink shadow-lg sm:-left-6 sm:top-10">
        <span class="text-xs font-semibold tracking-[0.2em] text-primary-800">ACREDITACIÓN</span>
        <span class="text-[22px] font-medium">ONAC 18-LAC-020</span>
        <span class="text-[13px] text-[#3f4f4c]">ISO/IEC 17025:2017</span>
      </div>
    </div>
  </div>
</section>

<section class="border-b border-[#e3e0d7] bg-paper">
  <div class="mx-auto grid max-w-[1240px] grid-cols-1 px-6 sm:grid-cols-2 lg:grid-cols-4">
    <div class="flex items-center gap-3.5 py-7 pr-6">
      <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#00695c" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3l7 3v6c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9V6Z"></path><path d="M9 12l2 2 4-4"></path></svg>
      <div><div class="text-[15px] font-semibold text-ink">Acreditación ONAC</div><div class="text-[13px] text-[#3f4f4c]">Código 18-LAC-020</div></div>
    </div>
    <div class="flex items-center gap-3.5 py-7 pr-6">
      <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#00695c" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="6" cy="12" r="2.5"></circle><circle cx="18" cy="6" r="2.5"></circle><circle cx="18" cy="18" r="2.5"></circle><path d="M8.3 11l7.4-3.8M8.3 13l7.4 3.8"></path></svg>
      <div><div class="text-[15px] font-semibold text-ink">Trazabilidad a NIST</div><div class="text-[13px] text-[#3f4f4c]">Patrones calibrados</div></div>
    </div>
    <div class="flex items-center gap-3.5 py-7 pr-6">
      <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#00695c" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21s-7-6.2-7-11a7 7 0 0 1 14 0c0 4.8-7 11-7 11Z"></path><circle cx="12" cy="10" r="2.5"></circle></svg>
      <div><div class="text-[15px] font-semibold text-ink">Dos sedes</div><div class="text-[13px] text-[#3f4f4c]">Dosquebradas y Bogotá</div></div>
    </div>
    <div class="flex items-center gap-3.5 py-7 pr-6">
      <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#00695c" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="9" cy="8" r="3.5"></circle><path d="M2.5 20c1-3.5 3.5-5.5 6.5-5.5s5.5 2 6.5 5.5M16 4.5a3.5 3.5 0 0 1 0 7M18 14.8c2 .8 3.2 2.6 3.8 5.2"></path></svg>
      <div><div class="text-[15px] font-semibold text-ink">500+ empresas</div><div class="text-[13px] text-[#3f4f4c]">IPS, clínicas e industria</div></div>
    </div>
  </div>
</section>
